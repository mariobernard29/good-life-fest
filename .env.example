# =============================================================================
# Good Life Wellness Fest — variables de entorno
# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local.
# Las variables NEXT_PUBLIC_* se envían al navegador: no pongas secretos en ellas.
# =============================================================================

# --- Aplicación ---------------------------------------------------------------
# URL pública del sitio (se usa en los correos de Supabase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | test | production
APP_ENV=development
# Slug del evento activo (tabla events). El seed de demostración usa este valor.
EVENT_SLUG=good-life-wellness-fest

# --- Supabase (Project Settings → API Keys) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Llave publicable (sb_publishable_...) — segura para el navegador, respeta RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Llave secreta (sb_secret_...) — SOLO servidor, omite RLS
SUPABASE_SECRET_KEY=


# --- Pago simulado -----------------------------------------------------------
# La venta en línea está desactivada (src/content/festival.ts → onlineSales).
# DEMO_PAYMENTS=false

# --- Correo (Resend · https://resend.com) ---------------------------------------
# Correos de activación de cuenta y recuperación de contraseña.
RESEND_API_KEY=
# Remitente con el dominio verificado en Resend
EMAIL_FROM="Good Life Wellness Fest <hola@tu-dominio.mx>"

# --- Notificaciones push (Web Push / VAPID) -------------------------------------
# Genera las llaves con:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del remitente de las notificaciones
VAPID_SUBJECT=mailto:hola@tu-dominio.mx
# Secreto compartido con el cron de Supabase que llama a /api/webhooks/notificaciones
CRON_SECRET=
