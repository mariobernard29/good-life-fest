# =============================================================================
# Good Life Wellness Fest — variables de entorno
# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local.
# Las variables NEXT_PUBLIC_* se envían al navegador: no pongas secretos en ellas.
# =============================================================================

# --- Aplicación ---------------------------------------------------------------
# URL pública del sitio (se usa en los correos de Supabase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | test | production
APP_ENV=development
# Slug del evento activo (tabla events). El seed de demostración usa este valor.
EVENT_SLUG=good-life-wellness-fest

# --- Supabase (Project Settings → API Keys) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Llave publicable (sb_publishable_...) — segura para el navegador, respeta RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Llave secreta (sb_secret_...) — SOLO servidor, omite RLS
SUPABASE_SECRET_KEY=

